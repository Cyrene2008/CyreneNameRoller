<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Jint" Version="4.15.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cyrene.Core.Bridge\Cyrene.Core.Bridge.csproj" />
    <ProjectReference Include="..\Cyrene.PluginSdk\Cyrene.PluginSdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\cyrene-core-bundle.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BundleCore" BeforeTargets="BeforeBuild" Condition="Exists('..\..\node_modules\esbuild')">
    <Exec Command="node ..\..\scripts\build-core-bundle.mjs" />
  </Target>

</Project>
