<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cyrene.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="vm:ListsViewModel"
             x:Class="Cyrene.App.Views.ListsView">
    <DockPanel Margin="0,0,24,24">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <TextBlock Text="名单管理" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CurrentListName}" FontSize="14" Opacity="0.7"/>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBox Watermark="输入姓名…" Text="{Binding NewPersonName}"/>
                <Button Grid.Column="1" Content="添加" Command="{Binding AddPersonCommand}"/>
            </Grid>
        </StackPanel>
        <Border Classes="card">
            <ListBox ItemsSource="{Binding People}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PersonItem">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="4">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="15"/>
                                <TextBlock Text="{Binding EnglishName}" FontSize="12" Opacity="0.6"/>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="6,2">
                                    <TextBlock Text="{Binding Group}" FontSize="11" Opacity="0.7"/>
                                </Border>
                                <Border IsVisible="{Binding IsWhiteList}" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                        CornerRadius="8" Padding="6,2">
                                    <TextBlock Text="白名单" FontSize="11" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2" Content="移除" Classes="subtle"
                                    Command="{Binding $parent[UserControl].((vm:ListsViewModel)DataContext).RemovePersonCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
