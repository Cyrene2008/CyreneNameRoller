<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Cyrene.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="800"
             x:DataType="vm:MainViewModel"
             x:Class="Cyrene.App.Views.SidebarView">

    <UserControl.Styles>
        <Style Selector="Border.nav-item">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.nav-item.pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>
        <Style Selector="Rectangle.selected-indicator">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.dock-layer">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26"/>
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource SidebarBackgroundBrush}" ClipToBounds="True"
            Width="{Binding SidebarWidth}">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.2"/>
            </Transitions>
        </Border.Transitions>
        <Grid>
            <!-- 主导航层：二级面板打开时整体左滑出（对齐 Tauri 版 dock-primary） -->
            <DockPanel x:Name="PrimaryLayer">
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,4">
                    <ItemsControl ItemsSource="{Binding BottomNavItems}" Margin="8,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Border Classes="nav-item"
                                        Tapped="OnNavItemTapped"
                                        PointerPressed="OnNavItemPointerPressed"
                                        PointerReleased="OnNavItemPointerReleased"
                                        PointerCaptureLost="OnNavItemPointerReleased"
                                        ToolTip.Tip="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PathIcon Width="20" Height="20"
                                                  HorizontalAlignment="Center"
                                                  Data="{Binding IconName, Converter={x:Static vm:BoolConverters.IconGeometry}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Opacity="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsCompact, Converter={x:Static vm:BoolConverters.CollapsedOpacity}}"/>
                                        <PathIcon Grid.Column="2" Width="12" Height="12"
                                                  Data="{Binding Converter={x:Static vm:BoolConverters.IconGeometry}, ConverterParameter=chevron-right-16-regular}"
                                                  IsVisible="{Binding HasChildren}" VerticalAlignment="Center" Opacity="0.6"/>
                                        <Rectangle Classes="selected-indicator"
                                                   Width="3" Height="22" RadiusX="1.5" RadiusY="1.5"
                                                   Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0"
                                                   Opacity="{Binding IsSelected, Converter={x:Static vm:BoolConverters.SelectedOpacity}}"
                                                   RenderTransform="{Binding IsSelected, Converter={x:Static vm:BoolConverters.SelectedScale}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ScrollViewer Margin="8">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Border Classes="nav-item"
                                        Tapped="OnNavItemTapped"
                                        PointerPressed="OnNavItemPointerPressed"
                                        PointerReleased="OnNavItemPointerReleased"
                                        PointerCaptureLost="OnNavItemPointerReleased"
                                        ToolTip.Tip="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PathIcon Width="20" Height="20"
                                                  HorizontalAlignment="Center"
                                                  Data="{Binding IconName, Converter={x:Static vm:BoolConverters.IconGeometry}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Opacity="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsCompact, Converter={x:Static vm:BoolConverters.CollapsedOpacity}}"/>
                                        <PathIcon Grid.Column="2" Width="12" Height="12"
                                                  Data="{Binding Converter={x:Static vm:BoolConverters.IconGeometry}, ConverterParameter=chevron-right-16-regular}"
                                                  IsVisible="{Binding HasChildren}" VerticalAlignment="Center" Opacity="0.6"/>
                                        <Rectangle Classes="selected-indicator"
                                                   Width="3" Height="22" RadiusX="1.5" RadiusY="1.5"
                                                   Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0"
                                                   Opacity="{Binding IsSelected, Converter={x:Static vm:BoolConverters.SelectedOpacity}}"
                                                   RenderTransform="{Binding IsSelected, Converter={x:Static vm:BoolConverters.SelectedScale}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- 二级滑入面板：顶部返回 + 子项列表（对齐 Tauri 版 SecondarySidebarMenu） -->
            <DockPanel x:Name="SecondaryLayer" Background="{DynamicResource SidebarBackgroundBrush}"
                       IsHitTestVisible="{Binding ActiveMenu, Converter={x:Static vm:BoolConverters.MenuOpen}}">
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,6,8,10" Margin="0,0,0,0">
                    <Button Classes="subtle" HorizontalContentAlignment="Left"
                            Command="{Binding CloseMenuCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Width="18" Height="18"
                                      Data="{Binding Converter={x:Static vm:BoolConverters.IconGeometry}, ConverterParameter=arrow-left-20-regular}"/>
                            <TextBlock Text="返回" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
                <ScrollViewer Margin="8,4">
                    <ItemsControl ItemsSource="{Binding ActiveMenuChildren}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavItem">
                                <Border Classes="nav-item"
                                        Tapped="OnNavItemTapped"
                                        PointerPressed="OnNavItemPointerPressed"
                                        PointerReleased="OnNavItemPointerReleased"
                                        PointerCaptureLost="OnNavItemPointerReleased"
                                        ToolTip.Tip="{Binding Title}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <PathIcon Width="18" Height="18"
                                                  HorizontalAlignment="Center"
                                                  Data="{Binding IconName, Converter={x:Static vm:BoolConverters.IconGeometry}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                   Margin="9,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Opacity="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).IsCompact, Converter={x:Static vm:BoolConverters.CollapsedOpacity}}"/>
                                        <Rectangle Classes="selected-indicator"
                                                   Width="3" Height="20" RadiusX="1.5" RadiusY="1.5"
                                                   Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0"
                                                   Opacity="{Binding IsSelected, Converter={x:Static vm:BoolConverters.SelectedOpacity}}"
                                                   RenderTransform="{Binding IsSelected, Converter={x:Static vm:BoolConverters.SelectedScale}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
