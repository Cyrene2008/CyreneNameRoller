    "preview": "vite preview",
    "plugin:create": "node packages/cyrene-name-roller/bin/cnrp.mjs create",
    "plugin:validate": "node packages/cyrene-name-roller/bin/cnrp.mjs validate",
    "plugin:pack": "node packages/cyrene-name-roller/bin/cnrp.mjs pack",
    "plugin:pack:sound": "node packages/cyrene-name-roller/bin/cnrp.mjs pack plugin-dev/sound-effects --out plugin-dev/dist/sound-effects-1.0.0.cnrp",
    "plugin:sdk:pack": "node scripts/prepare-plugin-sdk-output.mjs",
    "test": "node --test scripts/removed-desktop-runtime.test.js scripts/cyrene-balance.test.mjs scripts/plugin-sdk.test.mjs"
  },
  "dependencies": {
